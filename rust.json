{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Rust apps (scat, ElevenClock-rs)."
  ],
  "packageRules": [
    {
      "description": [
        "Cargo"
      ],
      "matchManagers": [
        "cargo"
      ],
      "addLabels": [
        "rust"
      ]
    },
    {
      "description": [
        "The clap crates (clap, clap_complete, clap_mangen, ...) are released together; one PR instead of one per crate."
      ],
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "clap",
        "clap_*"
      ],
      "groupName": "clap"
    }
  ]
}
