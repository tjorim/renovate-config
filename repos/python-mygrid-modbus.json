{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tjorim/renovate-config:python-library"
  ],
  "packageRules": [
    {
      "description": [
        "modbus-connection, tmodbus and pymodbus move together"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "modbus-connection",
        "tmodbus",
        "pymodbus"
      ],
      "groupName": "modbus"
    }
  ]
}
