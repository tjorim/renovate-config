{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Shared base for the tjorim repos: schedule, labels, commit style and the ecosystems every repo has."
  ],
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "ignorePresets": [
    "group:monorepos",
    "group:recommended"
  ],
  "enabledManagers": [
    "npm",
    "pep621",
    "cargo",
    "gradle",
    "gradle-wrapper",
    "dockerfile",
    "docker-compose",
    "nodenv",
    "github-actions",
    "git-submodules",
    "ansible-galaxy"
  ],
  "timezone": "UTC",
  "schedule": [
    "* 18-23 * * 5"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on monday"
    ],
    "description": [
      "Weekly lockfile refresh for every manager that has one (pnpm, npm, uv, cargo, gradle). Moves transitive packages in one PR instead of one PR each.",
      "This is Renovate's own default window, not the Friday window of the other updates: lockfile maintenance has a separate schedule that the base schedule does not override."
    ]
  },
  "assignees": [
    "tjorim"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 20,
  "prHourlyLimit": 0,
  "dependencyDashboard": true,
  "semanticCommits": "disabled",
  "commitMessagePrefix": "deps:",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": [
        "GitHub Actions"
      ],
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "github-actions"
      ],
      "commitMessagePrefix": "ci:"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "github/codeql-action",
        "github/codeql-action/**"
      ],
      "groupName": "codeql"
    },
    {
      "description": [
        "Dockerfiles"
      ],
      "matchManagers": [
        "dockerfile"
      ],
      "addLabels": [
        "docker"
      ],
      "commitMessagePrefix": "deps(docker):"
    },
    {
      "description": [
        "docker-compose files"
      ],
      "matchManagers": [
        "docker-compose"
      ],
      "addLabels": [
        "docker"
      ],
      "commitMessagePrefix": "deps(compose):"
    },
    {
      "description": [
        "npm / pnpm"
      ],
      "matchManagers": [
        "npm"
      ],
      "addLabels": [
        "npm"
      ]
    },
    {
      "description": [
        "Keep packageManager/engines and the minimum supported Python version under manual policy control. Python build-system requirements are dependencies and receive ordinary reviewed updates."
      ],
      "matchDepTypes": [
        "packageManager",
        "engines",
        "requires-python"
      ],
      "enabled": false
    },
    {
      "description": [
        "Python"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "addLabels": [
        "python"
      ]
    },
    {
      "description": [
        "Keep the precision of runtime versions: node:26-alpine, python:3.15-slim, node-version: 22, python-version: '3.15' and bun-version: '1' float within their major (or minor) on their own. Without this Renovate rewrites them to an exact release, then needs a PR for every patch."
      ],
      "matchDepNames": [
        "node",
        "python",
        "bun"
      ],
      "matchManagers": [
        "dockerfile",
        "github-actions"
      ],
      "versioning": "docker"
    }
  ]
}
